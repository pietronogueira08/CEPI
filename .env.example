# ==============================================
# CEPI — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ==============================================

# ----------------------------------------------
# BANCO DE DADOS
# ----------------------------------------------

# Desenvolvimento local (SQLite — gerado com: npm run db:push)
DATABASE_URL="file:./prisma/dev.db"

# Produção (Turso — https://turso.tech, plano gratuito disponível)
# 1. Crie uma conta em turso.tech
# 2. Crie um banco: turso db create cepi
# 3. Obtenha a URL: turso db show cepi --url
# 4. Gere o token: turso db tokens create cepi
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ----------------------------------------------
# AUTENTICAÇÃO (Auth.js v5)
# ----------------------------------------------

# Gere uma string aleatória forte para produção:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="cepi-super-secret-key-change-in-production-2024"

# URL da aplicação (sem barra no final)
# Desenvolvimento: http://localhost:3000
# Produção Vercel: https://seu-projeto.vercel.app (ou domínio próprio)
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------
# MFA
# ----------------------------------------------
MFA_ISSUER="CEPI Gestão Escolar"

# ==============================================
# CHECKLIST VERCEL (variáveis obrigatórias em produção)
# ==============================================
# ✅ TURSO_DATABASE_URL   — URL do banco Turso
# ✅ TURSO_AUTH_TOKEN     — Token de autenticação Turso
# ✅ NEXTAUTH_SECRET      — String aleatória longa
# ✅ NEXTAUTH_URL         — URL do seu deploy (ex: https://cepi.vercel.app)
# ✅ MFA_ISSUER           — Nome exibido no Google Authenticator
